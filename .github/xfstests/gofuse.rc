# go-fuse loopback mount lifecycle for xfstests.
# common/rc sources this file after defining its default mount helpers.

_gofuse_start_instance()
{
	local mount_dir="$1" backing_dir="$2" pid_file="$3" log_file="$4" label="$5"
	local pid attempt

	mkdir -p "$mount_dir" "$backing_dir"
	if mountpoint -q "$mount_dir"; then
		stat "$mount_dir" >/dev/null 2>&1 && return 0
		echo "go-fuse $label mount exists but is inaccessible: $mount_dir" >&2
		return 1
	fi

	rm -f "$pid_file"
	"$GOFUSE_BIN" "$mount_dir" "$backing_dir" >"$log_file" 2>&1 &
	pid=$!
	printf '%s\n' "$pid" > "$pid_file"

	for attempt in $(seq 1 30); do
		if ! kill -0 "$pid" 2>/dev/null; then
			echo "go-fuse $label exited before mounting (pid=$pid)" >&2
			cat "$log_file" >&2 || true
			rm -f "$pid_file"
			return 1
		fi
		if mountpoint -q "$mount_dir" && stat "$mount_dir" >/dev/null 2>&1; then
			printf 'go-fuse %s mounted: %s (pid=%s)\n' "$label" "$mount_dir" "$pid" >&2
			return 0
		fi
		sleep 1
	done

	echo "timed out waiting for go-fuse $label mount: $mount_dir" >&2
	cat "$log_file" >&2 || true
	kill "$pid" 2>/dev/null || true
	rm -f "$pid_file"
	return 1
}

_gofuse_stop_instance()
{
	local mount_dir="$1" pid_file="$2" label="$3"
	local pid attempt

	if mountpoint -q "$mount_dir"; then
		"${FUSERMOUNT_PROG:-fusermount3}" -u "$mount_dir" || {
			echo "failed to unmount go-fuse $label: $mount_dir" >&2
			return 1
		}
	fi

	if [ -f "$pid_file" ]; then
		pid=$(cat "$pid_file" 2>/dev/null || true)
		if [[ "$pid" =~ ^[0-9]+$ ]]; then
			for attempt in $(seq 1 10); do
				kill -0 "$pid" 2>/dev/null || break
				sleep 1
			done
			if kill -0 "$pid" 2>/dev/null; then
				kill "$pid" 2>/dev/null || true
			fi
		fi
		rm -f "$pid_file"
	fi

	if mountpoint -q "$mount_dir"; then
		echo "go-fuse $label is still mounted: $mount_dir" >&2
		return 1
	fi
	return 0
}

_gofuse_mount_snapshot()
{
	local label="$1"
	printf '%s\n' "--- go-fuse mount snapshot: $label ---" >&2
	printf 'time=%s TEST_DIR=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$TEST_DIR" >&2
	mountpoint -q "$TEST_DIR" && echo "mountpoint=mounted" >&2 || echo "mountpoint=not-mounted" >&2
	[ -d "$TEST_DIR" ] && echo "directory=exists" >&2 || echo "directory=missing" >&2
	if [ -f "${GOFUSE_PID_FILE:-}" ]; then
		local pid
		pid=$(cat "$GOFUSE_PID_FILE" 2>/dev/null || true)
		printf 'pid=%s\n' "$pid" >&2
		if [[ "$pid" =~ ^[0-9]+$ ]]; then
			ps -o pid,ppid,stat,args -p "$pid" >&2 || true
		fi
	fi
}

_test_mount()
{
	: "${GOFUSE_BIN:?GOFUSE_BIN is required}"
	: "${GOFUSE_BACKING_DIR:?GOFUSE_BACKING_DIR is required}"
	: "${GOFUSE_PID_FILE:?GOFUSE_PID_FILE is required}"
	: "${GOFUSE_LOG:?GOFUSE_LOG is required}"

	_gofuse_mount_snapshot "before _test_mount"
	_gofuse_start_instance "$TEST_DIR" "$GOFUSE_BACKING_DIR" "$GOFUSE_PID_FILE" "$GOFUSE_LOG" "test"
}

_test_unmount()
{
	_gofuse_mount_snapshot "before _test_unmount"
	_gofuse_stop_instance "$TEST_DIR" "$GOFUSE_PID_FILE" "test" || return 1
	_gofuse_mount_snapshot "after _test_unmount"
}

# FUSE has no mkfs operation. xfstests' default _scratch_mkfs path already
# clears SCRATCH_MNT by calling _scratch_mount/_scratch_unmount for FUSE.
# Provide a second independent loopback mount for that scratch filesystem.
_try_scratch_mount()
{
	: "${GOFUSE_SCRATCH_BACKING_DIR:?GOFUSE_SCRATCH_BACKING_DIR is required}"
	: "${GOFUSE_SCRATCH_PID_FILE:?GOFUSE_SCRATCH_PID_FILE is required}"
	: "${GOFUSE_SCRATCH_LOG:?GOFUSE_SCRATCH_LOG is required}"
	_gofuse_start_instance "$SCRATCH_MNT" "$GOFUSE_SCRATCH_BACKING_DIR" "$GOFUSE_SCRATCH_PID_FILE" "$GOFUSE_SCRATCH_LOG" "scratch"
}

_scratch_unmount()
{
	_gofuse_stop_instance "$SCRATCH_MNT" "$GOFUSE_SCRATCH_PID_FILE" "scratch"
}

# Linux reports FUSE filesystems as fuse.<subtype> in df/findmnt.
# xfstests' FSTYP contract uses the generic type "fuse", so normalize
# the subtype for its mount validation without changing the actual mount.
_fs_type()
{
	if [ $# -ne 1 ]; then
		echo "Usage: _fs_type device" >&2
		_exit 1
	fi

	_df_device "$1" | $AWK_PROG '{ print $2 }' | \
		sed -e 's/nfs4/nfs/' \
		    -e 's/fuse.glusterfs/glusterfs/' \
		    -e 's/fuse.ceph-fuse/ceph-fuse/' \
		    -e 's/^fuse\\..*/fuse/'
}
