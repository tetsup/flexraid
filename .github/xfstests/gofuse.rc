# go-fuse loopback mount lifecycle for xfstests.
# common/rc sources this file after defining its default mount helpers.

_gofuse_mount_snapshot()
{
	printf '%s\n' "--- go-fuse mount snapshot: $1 ---" >&2
	printf 'time=%s TEST_DIR=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$TEST_DIR" >&2
	mountpoint -q "$TEST_DIR" && echo "mountpoint=mounted" >&2 || echo "mountpoint=not-mounted" >&2
	[ -d "$TEST_DIR" ] && echo "directory=exists" >&2 || echo "directory=missing" >&2
	if [ -f "${GOFUSE_PID_FILE:-}" ]; then
		local pid
		pid=$(cat "$GOFUSE_PID_FILE" 2>/dev/null || true)
		printf 'pid=%s\n' "$pid" >&2
		if [[ "$pid" =~ ^[0-9]+$ ]]; then
			ps -o pid,ppid,stat,args -p "$pid" >&2 || true
		fi
	fi
}

_test_mount()
{
	: "${GOFUSE_BIN:?GOFUSE_BIN is required}"
	: "${GOFUSE_BACKING_DIR:?GOFUSE_BACKING_DIR is required}"
	: "${GOFUSE_PID_FILE:?GOFUSE_PID_FILE is required}"

	_gofuse_mount_snapshot "before _test_mount"
	if mountpoint -q "$TEST_DIR"; then
		stat "$TEST_DIR" >/dev/null 2>&1 && return 0
		echo "go-fuse mount exists but is inaccessible: $TEST_DIR" >&2
		return 1
	fi

	mkdir -p "$TEST_DIR" "$GOFUSE_BACKING_DIR"
	rm -f "$GOFUSE_PID_FILE"
	"$GOFUSE_BIN" "$TEST_DIR" "$GOFUSE_BACKING_DIR" >"${GOFUSE_LOG:-/tmp/gofuse-loopback.log}" 2>&1 &
	local pid=$!
	printf '%s\n' "$pid" > "$GOFUSE_PID_FILE"

	local attempt
	for attempt in $(seq 1 30); do
		if ! kill -0 "$pid" 2>/dev/null; then
			echo "go-fuse loopback exited before mounting (pid=$pid)" >&2
			cat "${GOFUSE_LOG:-/tmp/gofuse-loopback.log}" >&2 || true
			rm -f "$GOFUSE_PID_FILE"
			return 1
		fi
		if mountpoint -q "$TEST_DIR" && stat "$TEST_DIR" >/dev/null 2>&1; then
			_gofuse_mount_snapshot "mount succeeded"
			return 0
		fi
		sleep 1
	done

	echo "timed out waiting for go-fuse mount: $TEST_DIR" >&2
	cat "${GOFUSE_LOG:-/tmp/gofuse-loopback.log}" >&2 || true
	kill "$pid" 2>/dev/null || true
	rm -f "$GOFUSE_PID_FILE"
	return 1
}

_test_unmount()
{
	_gofuse_mount_snapshot "before _test_unmount"
	if mountpoint -q "$TEST_DIR"; then
		"${FUSERMOUNT_PROG:-fusermount3}" -u "$TEST_DIR" || {
			echo "failed to unmount go-fuse TEST_DIR=$TEST_DIR" >&2
			return 1
		}
	fi

	if [ -f "${GOFUSE_PID_FILE:-}" ]; then
		local pid attempt
		pid=$(cat "$GOFUSE_PID_FILE" 2>/dev/null || true)
		if [[ "$pid" =~ ^[0-9]+$ ]]; then
			for attempt in $(seq 1 10); do
				kill -0 "$pid" 2>/dev/null || break
				sleep 1
			done
			if kill -0 "$pid" 2>/dev/null; then
				kill "$pid" 2>/dev/null || true
			fi
		fi
		rm -f "$GOFUSE_PID_FILE"
	fi

	if mountpoint -q "$TEST_DIR"; then
		echo "go-fuse TEST_DIR is still mounted after unmount" >&2
		return 1
	fi
	_gofuse_mount_snapshot "after _test_unmount"
}
